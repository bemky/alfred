{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/hooks/gh-api-allow-quoted-braces.py",
            "if": "Bash(gh api:*)"
          }
        ]
      }
    ]
  }
}
